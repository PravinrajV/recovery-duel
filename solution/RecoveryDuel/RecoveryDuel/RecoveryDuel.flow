    {
      "nodeType": "core.logic.dowhile",
      "supportsErrorHandling": true,
      "version": "1.0",
      "category": "control-flow",
      "description": "Repeat a sequence of actions while a condition is true",
      "tags": [
        "control-flow",
        "loop",
        "iteration",
        "dowhile"
      ],
      "sortOrder": 64,
      "display": {
        "label": "Do while",
        "icon": "repeat",
        "shape": "container",
        "description": "Run a sequence of actions repeatedly while a condition is true"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "boundary": "outer",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "boundary": "outer",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            }
          ]
        },
        {
          "position": "left",
          "boundary": "inner",
          "handles": [
            {
              "id": "start",
              "label": "start",
              "type": "source",
              "handleType": "output"
            }
          ]
        },
        {
          "position": "right",
          "boundary": "inner",
          "handles": [
            {
              "id": "continue",
              "label": "continue",
              "type": "target",
              "handleType": "input"
            },
            {
              "id": "break",
              "label": "break",
              "type": "target",
              "handleType": "input",
              "visible": "inputs.breakEnabled"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:SubProcess"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "Add a condition"
          },
          "limit": {
            "type": "number",
            "errorMessage": "Set maximum iterations"
          },
          "breakEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "condition"
        ]
      },
      "inputDefaults": {
        "condition": "",
        "breakEnabled": false
      },
      "outputDefinition": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "dowhile-properties",
        "title": "Do while configuration",
        "sections": [
          {
            "id": "iteration",
            "title": "Iteration",
            "fields": [
              {
                "name": "inputs.condition",
                "type": "custom",
                "component": "code-editor",
                "label": "Condition",
                "description": "The loop repeats while this condition is true. The condition is checked after each iteration.",
                "componentProps": {
                  "singleLine": true,
                  "mode": "expression",
                  "toggleable": false,
                  "placeholder": "$vars.response.hasNextPage === true",
                  "showVariableButton": true,
                  "returnType": "boolean",
                  "validationMode": "expression",
                  "language": "javascript"
                }
              },
              {
                "name": "inputs.limit",
                "type": "number",
                "label": "Maximum iterations",
                "description": "The loop stops after this many iterations, even if the condition is still true. A blank field defaults to 10,000."
              },
              {
                "name": "inputs.breakEnabled",
                "type": "switch",
                "label": "Show break handle",
                "description": "Nodes inside the loop can exit through a break handle."
              }
            ]
          }
        ]
      }
    }
  ],
