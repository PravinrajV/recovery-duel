      "inputs": {
        "script": "const clean = (x) => typeof x === \"string\" ? x.replace(/\\s*[\\u2014\\u2013]\\s*/g, \", \").replace(/ ,/g, \",\")\n        : Array.isArray(x) ? x.map(clean) : (x && typeof x === \"object\") ? Object.keys(x).reduce((o, k) => { o[k] = clean(x[k]); return o; }, {}) : x;\n      return { negotiation: Object.assign(clean($vars.neg), { approval: clean($vars.approval) }), evidence: clean($vars.evidenceAnalyst.output || {}), liability: clean($vars.liabilityAssessor.output || {}) };"
      }
