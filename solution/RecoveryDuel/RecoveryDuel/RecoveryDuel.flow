    {
      "id": "parseStore",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1408,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "parseStore",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "const c = JSON.parse($vars.loadStore.output.claimsJson || \"{}\"); const cfg = JSON.parse($vars.loadStore.output.configJson || \"{}\");\n          const ids = $vars.start.output.claimIds || [];\n          const all = Array.isArray(c) ? c : (c.claims || []);\n          const claims = ids.length ? all.filter(x => ids.indexOf(x.claim_id) >= 0) : all;\n          return { source: \"bucket\", loaded: true, claims, total_in_bucket: all.length, kill_switch: cfg.kill_switch || {}, guardrails: cfg.guardrails || {} };"
      }
    },
    {
      "id": "intake",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 1696,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "intake",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "items": {
              "type": "array"
            },
            "stopped": {
              "type": "boolean"
            },
            "claims": {
              "type": "array"
            },
            "negotiation_paused": {
              "type": "boolean"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "\n      const st = $vars.storeValue || {}; const ks = st.kill_switch || {};\n      const rows = st.loaded ? (st.claims || []) : ($vars.start.output.claims || []);\n      const paused = ks.paused_states || [];\n      if ($vars.start.output.killSwitch || ks.global) return { items: [], stopped: true, claims: [] };\n      const items = rows.filter(c => c && c.claim_id && paused.indexOf(c.state) < 0).map(c => ({\n        ...c, paid_amount: Number(c.paid_amount), deductible: Number(c.deductible),\n        insured_fault_pct: Number(c.insured_fault_pct) }));\n      return { items, stopped: false, claims: rows, negotiation_paused: !!ks.negotiation };"
      }
    },
