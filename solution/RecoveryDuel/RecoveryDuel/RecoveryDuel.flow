      "inputs": {
        "script": "const n = $vars.neg; const settled = n.status === \"SETTLED\";\n      const h = (n.history || []).map(x => \"R\" + x.round + \" \" + x.from + \": \" + (x.offer != null ? x.offer : x.sent)).join(\"; \");\n      return { route: settled ? (n.tier || \"MANAGER\") : \"NONE\", claimId: n.claim_id || \"\", amount: Number(n.settled_amount) || 0, floor: Number(n.floor) || 0,\n        summary: \"SIMULATED counterparty. \" + n.status + \" after \" + n.round + \" rounds. \" + h };"
      }
