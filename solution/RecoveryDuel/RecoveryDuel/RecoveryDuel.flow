    {
      "id": "negInit",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 6880,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "negInit",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "state": {
              "type": "object"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "const a = $vars.pickTop.output.assessment || {};\n      const cp = $vars.start.output.counterparty || {}; const halt = $vars.halt || {};\n      const paused = !!$vars.start.output.killNegotiation || !!$vars.intake.output.negotiation_paused;\n      const status = !$vars.pickTop.output.found ? \"NO_CASE\" : halt.status ? \"NEEDS_REVIEW_AGENT_ERROR\" : paused ? \"PAUSED_KILL_SWITCH\" : \"OPEN\";\n      return { state: { claim_id: a.claim_id || null, round: 0, floor: a.floor || 0, last_ask: a.demand || 0, demand: a.demand || 0,\n        persona: cp.persona || \"cooperative\", reservation: Number(cp.reservation_price) || Math.round((a.demand || 0) * 0.9),\n        status, halt: halt.status ? halt : null, history: [], rationale: halt.status ? \"\" : (($vars.liabilityAssessor.output || {}).rationale || \"\"), simulated_counterparty: true } };"
      }
    },
