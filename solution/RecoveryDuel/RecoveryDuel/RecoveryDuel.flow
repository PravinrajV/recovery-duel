    {
      "id": "intake",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "ui": {
        "position": {
          "x": 544,
          "y": 144
        },
        "size": {
          "width": 96,
          "height": 96
        },
        "collapsed": false
      },
      "display": {
        "label": "intake",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "items": {
              "type": "array"
            },
            "stopped": {
              "type": "boolean"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "\n      const rows = $vars.start.output.claims || [];\n      if ($vars.start.output.killSwitch) return { items: [], stopped: true };\n      const items = rows.filter(c => c && c.claim_id).map(c => ({\n        ...c, paid_amount: Number(c.paid_amount), deductible: Number(c.deductible),\n        insured_fault_pct: Number(c.insured_fault_pct) }));\n      return { items, stopped: false };"
      }
    },
