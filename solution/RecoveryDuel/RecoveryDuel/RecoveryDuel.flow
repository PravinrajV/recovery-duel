              "label": "break",
              "type": "target",
              "handleType": "input",
              "visible": "inputs.breakEnabled"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:SubProcess"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "Add a condition"
          },
          "limit": {
            "type": "number",
            "errorMessage": "Set maximum iterations"
          },
          "breakEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "condition"
        ]
      },
      "inputDefaults": {
        "condition": "",
        "breakEnabled": false
      },
      "outputDefinition": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
