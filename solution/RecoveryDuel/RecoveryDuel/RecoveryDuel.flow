      "inputs": {
        "script": "const clean = (x) => typeof x === \"string\" ? x.replace(/\\s*[\\u2014\\u2013]\\s*/g, \", \").replace(/ ,/g, \",\")\n        : Array.isArray(x) ? x.map(clean) : (x && typeof x === \"object\") ? Object.keys(x).reduce((o, k) => { o[k] = clean(x[k]); return o; }, {}) : x;\n      return { negotiation: clean($vars.neg), evidence: clean($vars.evidenceAnalyst.output || {}), liability: clean($vars.liabilityAssessor.output || {}) };"
      }
    },
    {
