      "inputs": {
        "script": "const st = $vars.storeValue || {}; const l = ($vars.ledger && $vars.ledger.ok) ? $vars.ledger : null; return { source: st.source || \"input\", loaded: !!st.loaded, total_in_bucket: st.total_in_bucket || null, ledger_appended: !!(l && l.ok), ledger_count: l ? l.ledgerCount : null };"
      }
    },
