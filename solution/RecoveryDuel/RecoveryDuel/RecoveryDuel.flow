      "form": {
        "id": "dowhile-properties",
        "title": "Do while configuration",
        "sections": [
          {
            "id": "iteration",
            "title": "Iteration",
            "fields": [
              {
                "name": "inputs.condition",
                "type": "custom",
                "component": "code-editor",
                "label": "Condition",
                "description": "The loop repeats while this condition is true. The condition is checked after each iteration.",
                "componentProps": {
                  "singleLine": true,
                  "mode": "expression",
                  "toggleable": false,
                  "placeholder": "$vars.response.hasNextPage === true",
                  "showVariableButton": true,
                  "returnType": "boolean",
                  "validationMode": "expression",
                  "language": "javascript"
                }
              },
              {
                "name": "inputs.limit",
                "type": "number",
                "label": "Maximum iterations",
                "description": "The loop stops after this many iterations, even if the condition is still true. A blank field defaults to 10,000."
              },
              {
                "name": "inputs.breakEnabled",
                "type": "switch",
                "label": "Show break handle",
                "description": "Nodes inside the loop can exit through a break handle."
              }
            ]
          }
        ]
      }
