        "script": "const top = ($vars.rank.output.ranked || []).find(a => a.status === \"PURSUE\") || null;\n      const c = top ? ($vars.intake.output.claims || []).find(x => x.claim_id === top.claim_id) || {} : {};\n      return { found: !!top, assessment: top || {}, claim: c, claimJson: JSON.stringify(c), assessmentJson: JSON.stringify(top || {}) };"
