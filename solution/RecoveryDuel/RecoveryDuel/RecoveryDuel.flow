                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "collection": {
          "type": "jsExpression",
          "expression": "$vars.intake.output.items",
          "fieldType": "array"
        },
        "parallel": false,
        "breakEnabled": false
      }
