            "fieldType": "string"
          },
          "var": "collection",
          "scope": "internal"
        },
        "output": {
          "type": "array",
          "description": "Aggregated results from all loop iterations",
          "source": {
            "type": "literal",
            "expression": "=loopContext.output",
            "fieldType": "string"
          },
          "var": "output",
          "scope": "external"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": {
            "type": "literal",
            "expression": "=Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
