{
  "Result": "Success",
  "Code": "NodeGetSuccess",
  "Data": {
    "Node": {
      "nodeType": "uipath.pattern.deep-rag",
      "version": "1.1",
      "category": "document-processing",
      "tags": [
        "synthesis",
        "citation",
        "reasoning"
      ],
      "sortOrder": 1,
      "supportsErrorHandling": true,
      "description": "Create a complex summary of a document",
      "display": {
        "label": "Summarize document",
        "icon": "sigma",
        "isPreview": true
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "ECS.DeepRag"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "attachment": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "returnCitations": {
            "type": "boolean"
          }
        },
        "required": [
          "attachment",
          "prompt"
        ]
      },
      "inputDefaults": {
        "attachment": "",
        "prompt": "",
        "returnCitations": false
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "source": "=response",
          "var": "output",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "content": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "Text": {
                    "type": "string"
                  },
                  "Citations": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "object",
                      "properties": {
                        "Ordinal": {
                          "type": "integer"
                        },
                        "PageNumber": {
                          "type": "integer"
                        },
                        "Source": {
                          "type": "string"
                        },
                        "Reference": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "deep-rag-properties",
        "title": "Summarize Configuration",
        "sections": [
          {
            "id": "source",
            "title": "Data source",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.attachment",
                "type": "file",
                "label": "Attachment",
                "description": "The summary is generated from this file or document.",
                "validation": {
                  "required": true,
                  "messages": {
                    "required": "Attachment is required"
                  }
                }
              },
              {
                "name": "inputs.prompt",
                "type": "custom",
                "component": "prompt-editor",
                "label": "Prompt",
                "description": "The prompt defines what the summary should focus on.",
                "componentProps": {
                  "multiline": true,
                  "minRows": 4,
                  "maxRows": 20,
                  "placeholder": "Summarize the key findings and risks"
                },
                "validation": {
                  "required": true,
                  "messages": {
                    "required": "Prompt is required"
                  }
                }
              }
            ]
          },
          {
            "id": "citations",
            "title": "Citations",
            "collapsible": true,
            "defaultExpanded": false,
            "fields": [
              {
                "name": "inputs.returnCitations",
                "type": "checkbox",
                "label": "Include citations",
                "description": "Citations link generated summaries to source material."
              }
            ]
          }
        ]
      }
    }
  }
}
